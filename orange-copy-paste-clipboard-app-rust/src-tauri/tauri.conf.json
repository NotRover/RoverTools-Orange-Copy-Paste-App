{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orange Copy Paste",
  "version": "0.1.0",
  "identifier": "com.spect.orange-copy-paste",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "src/components/app/",
        "title": "Orange Copy Paste",
        "width": 920,
        "height": 560,
        "minWidth": 640,
        "minHeight": 440,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0e0e0e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
