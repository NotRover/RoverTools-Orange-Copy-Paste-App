{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Clipboard",
  "version": "0.1.0",
  "identifier": "com.spect.notrover-smart-clipboard",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "src/components/app/",
        "title": "Smart Clipboard",
        "width": 480,
        "height": 700,
        "minWidth": 380,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
